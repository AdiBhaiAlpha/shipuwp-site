{
  "rules": {
    ".read": false,
    ".write": false,

    "_README": {
      ".read": true
    },

    "users": {
      ".read": "auth != null",

      "$uid": {
        ".write": false,

        "uid": { ".write": "auth != null" },
        "firebaseUid": { ".write": "auth != null" },
        "username": { ".write": "auth != null" },
        "email": { ".write": "auth != null" },
        "usernameLower": { ".write": "auth != null" },
        "createdAt": { ".write": "auth != null" },
        "lastLoginAt": { ".write": "auth != null" },
        "updatedAt": { ".write": "auth != null" },

        "usage": {
          "$day": {
            ".write": false,
            "date": { ".write": "auth != null" },
            "model": { ".write": "auth != null" },
            "repliesUsed": { ".write": "auth != null" }
          }
        }
      }
    },

    "payments": {
      "$paymentId": {
        ".read": "auth != null",
        ".write": false,

        "uid": { ".write": "auth != null" },
        "username": { ".write": "auth != null" },
        "termuxUsername": { ".write": "auth != null" },
        "senderNumber": { ".write": "auth != null" },
        "remitterNumber": { ".write": "auth != null" },
        "plan": { ".write": "auth != null" },
        "durationDays": { ".write": "auth != null" },
        "amount": { ".write": "auth != null" },
        "currency": { ".write": "auth != null" },
        "method": { ".write": "auth != null" },
        "transactionId": { ".write": "auth != null" },
        "createdAt": { ".write": "auth != null" },
        "updatedAt": { ".write": "auth != null" },

        "status": { ".write": false },
        "verifiedAt": { ".write": false },
        "verifiedBy": { ".write": false },
        "reason": { ".write": false },
        "expiresAt": { ".write": false }
      }
    },

    "admins": {
      ".read": "auth != null && data.child(auth.uid).child('active').val() === true",
      "$uid": {
        ".write": false
      }
    }
  }
}